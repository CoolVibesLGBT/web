# CoolVibes Web – environment variables (optional)
# Copy to .env and set values for local overrides.
# API and socket URLs are derived from hostname in production (coolvibes.gay, etc.).

# VITE_API_URL=https://api.coolvibes.gay
# VITE_SOCKET_URL=wss://socket.coolvibes.gay
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
